        "$request": {
          ".write": "auth != null && (auth.token.email === 'edisonkuo1030@gmail.com' || (auth.uid === $uid && ((!data.exists() && newData.child('status').val() === 'pending') || (data.exists() && data.child('status').val() === 'pending' && !newData.exists()))))",
          ".validate": "newData.hasChildren(['id','accountId','amount','status','createdAt']) && newData.child('accountId').val() === $uid && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'approved' || newData.child('status').val() === 'rejected')"
        }
      }
    },
    "depositRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'edisonkuo1030@gmail.com')",
        "$request": {
